        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown h6",
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#8a3f64",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#7e6410",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
