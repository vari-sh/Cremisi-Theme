  "semanticTokenColors": {
    "selfParameter": {
      "foreground": "#7e3a9e",
      "fontStyle": "italic"
    },
    "selfKeyword": {
      "foreground": "#7e3a9e",
      "fontStyle": "italic"
    },
    "function.defaultLibrary": {
      "foreground": "#7e3a9e",
      "fontStyle": "italic"
    },
    "decorator": {
      "foreground": "#a24d20"
    },
    "macro": {
      "foreground": "#a24d20"
    },
    "enumMember": {
      "foreground": "#9f5c12"
    },
    "parameter": {
      "foreground": "#a8465f",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#1a706d"
    },
    "variable.typeHint:python": {
      "foreground": "#7e6410",
      "fontStyle": "italic"
    },
    "variable.readonly:javascript": {
      "foreground": "#2b2733"
    },
    "property.readonly:javascript": {
      "foreground": "#1a706d"
    },
    "variable.readonly:javascriptreact": {
      "foreground": "#2b2733"
    },
    "property.readonly:javascriptreact": {
      "foreground": "#1a706d"
    },
    "variable.readonly:typescript": {
      "foreground": "#2b2733"
    },
    "property.readonly:typescript": {
      "foreground": "#1a706d"
    },
    "variable.readonly:typescriptreact": {
      "foreground": "#2b2733"
    },
    "property.readonly:typescriptreact": {
      "foreground": "#1a706d"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a7f8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#bb1f39",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#bb1f39",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Imports",
      "scope": [
        "keyword.control.import",
        "keyword.control.at-rule",
        "keyword.other.import",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#8a3f64",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#8a3f64"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "variable.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#2d5c9c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Builtins and self",
      "scope": [
        "support.function.builtin",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7e3a9e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#7e6410",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes and namespaces",
      "scope": [
        "entity.name.class",
        "entity.name.struct",
        "entity.name.namespace",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7e6410",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#2f7a4e"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a24d20"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9f5c12"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#9f5c12",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#bb1f39",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9f5c12"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#a8465f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#2b2733"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.member",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#1a706d"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.decorator",
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#a24d20"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7e6410",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#bb1f39"
      }
    },
    {
      "name": "Exceptions",
      "scope": [
        "support.type.exception",
        "support.class.exception"
      ],
      "settings": {
        "foreground": "#bb1f39",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#64606c"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c42740",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#bb1f39"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2f7a4e"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#9f5c12"
      }
    },
    {
      "name": "Markdown h1",
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#bb1f39",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown h2",
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#9f5c12",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown h3",
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#7e6410",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown h4",
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#2f7a4e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown h5",
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
