    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#2d5c9c",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown raw",
